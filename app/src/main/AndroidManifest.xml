<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Screen capture and floating-button permissions -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <queries>
        <package android:name="com.nianticlabs.pokemongo" />
    </queries>

    <application android:name=".ReaderApplication" android:allowBackup="true" android:dataExtractionRules="@xml/data_extraction_rules" android:fullBackupContent="@xml/backup_rules" android:icon="@mipmap/ic_launcher" android:label="@string/app_name" android:roundIcon="@mipmap/ic_launcher_round" android:supportsRtl="true" android:theme="@style/Theme.PokemonIVReader">
        <activity android:name=".ReaderDiagnosticExportActivity" android:exported="false" android:label="読み取りの停止ログ" />
        <activity android:name=".overlayqueue.GoAutomationLogActivity" android:exported="false" android:label="自動入力の停止ログ" />
        <activity android:name=".ReaderAutomationResultActivity" android:exported="true"
            android:label="厳選結果を受け取る" android:theme="@style/Theme.PokemonIVReader.AutomationReturn"
            android:taskAffinity="${applicationId}.automationReturn" android:launchMode="singleTask"
            android:noHistory="true" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pokemonivreader" android:host="automation" />
            </intent-filter>
        </activity>
        <activity android:name=".ReaderBackupActivity" android:exported="false" android:label="Android履歴バックアップ" />
        <activity android:name=".catchassist.CatchTrialActivity" android:exported="false" android:label="捕獲の試験版" android:screenOrientation="portrait" />
        <activity android:name=".FlashcardActivity" android:exported="false" android:label="技カウント" android:windowSoftInputMode="adjustResize" />

        <activity android:name=".MainActivity" android:exported="true" android:label="@string/app_name" android:theme="@style/Theme.PokemonIVReader" android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service android:name=".ScreenCaptureService" android:exported="false" android:foregroundServiceType="mediaProjection" />

    <activity android:name="com.example.pokemonivreader.overlayqueue.OverlayCopyQueueImportActivity" android:label="厳選検索式を取り込む" android:exported="true" android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pokemonivreader" android:host="import" />
            </intent-filter><intent-filter><action android:name="android.intent.action.SEND" /><category android:name="android.intent.category.DEFAULT" /><data android:mimeType="text/plain" /></intent-filter></activity><activity-alias android:name="com.example.pokemonivreader.overlayqueue.OverlayQueueLauncher" android:targetActivity="com.example.pokemonivreader.overlayqueue.OverlayCopyQueueImportActivity" android:label="厳選コピーリスト" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter></activity-alias>
        <!-- Optional: only reads the Pokémon GO UI after an explicit input request. -->
        <service
            android:name="com.example.pokemonivreader.overlayqueue.GoTextInputAccessibilityService"
            android:label="厳選テキスト入力"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/go_text_input_service" />
        </service>
    </application>
</manifest>

